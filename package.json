{
  "name": "fitness-library",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "format": "prettier --write src tests *.json *.ts index.html README.md",
    "test:e2e": "playwright test",
    "test:rules": "firebase emulators:exec --config firebase.test.json --project demo-fitness-library --only firestore 'node --test tests/firestore.rules.test.mjs'",
    "firebase:configure": "node scripts/configure-firebase.mjs",
    "deploy": "npm run firebase:configure && npm run build && firebase deploy --only firestore,hosting"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "firebase": "^13.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "firebase-tools": "^15.35.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^5.1.0"
  }
}
